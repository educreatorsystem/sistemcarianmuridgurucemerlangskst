eight:50px;object-fit:contain}\n .print-cover h1{font-size:15px;margin:0 0 3px;font-weight:800;color:#111}\n .print-cover h2{font-size:12px;margin:0 0 4px;font-weight:700;color:#111}\n .print-cover p{font-size:10px;margin:0;color:#333}\n .print-warning{font-size:9px;border:1px solid #ddd;padding:6px 9px;background:#f5f5f5;color:#333;margin-bottom:10px}\n .print-table{width:100%;border-collapse:collapse;table-layout:fixed;font-size:9px;line-height:1.35}\n .print-table thead{display:table-header-group}\n .print-table tr{break-inside:avoid;page-break-inside:avoid}\n .print-table th,.print-table td{border:1px solid #aaa;padding:6px;vertical-align:top;text-align:left;white-space:normal;overflow-wrap:anywhere}\n .print-table th{background:#eee!important;color:#111;font-weight:700;-webkit-print-color-adjust:exact;print-color-adjust:exact}\n .print-table .center{text-align:center}\n .print-end{margin-top:10px;font-size:9px;color:#555}\n}\n</style>\n</head>\n<body>\n<svg aria-hidden=\"true\" style=\"position:absolute;width:0;height:0;overflow:hidden\" xmlns=\"http://www.w3.org/2000/svg\"><defs>\n<symbol id=\"i-search\" viewBox=\"0 0 24 24\"><circle cx=\"11\" cy=\"11\" r=\"7\"/><path d=\"m20 20-4-4\"/></symbol>\n<symbol id=\"i-shield\" viewBox=\"0 0 24 24\"><path d=\"M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z\"/><path d=\"m9 12 2 2 4-4\"/></symbol>\n<symbol id=\"i-user\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"8\" r=\"4\"/><path d=\"M4 21v-2a8 8 0 0 1 16 0v2\"/></symbol>\n<symbol id=\"i-users\" viewBox=\"0 0 24 24\"><path d=\"M16 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2\"/><circle cx=\"10\" cy=\"7\" r=\"4\"/><path d=\"M20 21v-2a4 4 0 0 0-3-3.9M16 3.1a4 4 0 0 1 0 7.8\"/></symbol>\n<symbol id=\"i-star\" viewBox=\"0 0 24 24\"><path d=\"m12 2 3.1 6.3 7 1-5.1 4.9 1.2 7-6.2-3.3-6.2 3.3 1.2-7L2 9.3l7-1L12 2Z\"/></symbol>\n<symbol id=\"i-arrow\" viewBox=\"0 0 24 24\"><path d=\"M5 12h14m-6-6 6 6-6 6\"/></symbol>\n<symbol id=\"i-lock\" viewBox=\"0 0 24 24\"><rect x=\"4\" y=\"10\" width=\"16\" height=\"12\" rx=\"2\"/><path d=\"M8 10V7a4 4 0 0 1 8 0v3\"/></symbol>\n<symbol id=\"i-check\" viewBox=\"0 0 24 24\"><path d=\"m5 12 5 5L20 7\"/></symbol>\n<symbol id=\"i-refresh\" viewBox=\"0 0 24 24\"><path d=\"M20 7v5h-5M4 17v-5h5\"/><path d=\"M5 9a8 8 0 0 1 14-2l1 5M4 12l1 5a8 8 0 0 0 14-2\"/></symbol>\n<symbol id=\"i-info\" viewBox=\"0 0 24 24\"><circle cx=\"12\" cy=\"12\" r=\"10\"/><path d=\"M12 11v6m0-10h.01\"/></symbol>\n<symbol id=\"i-x\" viewBox=\"0 0 24 24\"><path d=\"M18 6 6 18M6 6l12 12\"/></symbol>\n<symbol id=\"i-eye\" viewBox=\"0 0 24 24\"><path d=\"M2 12S6 5 12 5s10 7 10 7-4 7-10 7S2 12 2 12Z\"/><circle cx=\"12\" cy=\"12\" r=\"3\"/></symbol>\n<symbol id=\"i-chart\" viewBox=\"0 0 24 24\"><path d=\"M4 20h16M7 16V9m5 7V4m5 12v-5\"/></symbol>\n<symbol id=\"i-download\" viewBox=\"0 0 24 24\"><path d=\"M12 3v12m-4-4 4 4 4-4M4 17v3h16v-3\"/></symbol>\n<symbol id=\"i-printer\" viewBox=\"0 0 24 24\"><path d=\"M7 8V3h10v5M7 17H5a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2\"/><path d=\"M7 14h10v7H7z\"/></symbol>\n<symbol id=\"i-sparkle\" viewBox=\"0 0 24 24\"><path d=\"m12 2 1.9 7.1L21 11l-7.1 1.9L12 20l-1.9-7.1L3 11l7.1-1.9L12 2Zm7 15 .8 2.2L22 20l-2.2.8L19 23l-.8-2.2L16 20l2.2-.8L19 17Z\"/></symbol>\n<symbol id=\"i-menu\" viewBox=\"0 0 24 24\"><path d=\"M4 7h16M4 12h16M4 17h16\"/></symbol>\n<symbol id=\"i-wifi\" viewBox=\"0 0 24 24\"><path d=\"M2 8.5a16 16 0 0 1 20 0M5 12.5a10 10 0 0 1 14 0m-11 4a5 5 0 0 1 8 0M12 20h.01\"/></symbol>\n</defs></svg>\n<div class=\"shell\">\n<header class=\"topbar\"><div class=\"container top-inner\">\n  <a href=\"#utama\" class=\"brand\" aria-label=\"Ke bahagian utama\"><div class=\"brand-mark\"><img id=\"schoolLogo\" alt=\"Lencana rasmi SK Sungai Tiram\" src=\"data:image/png;base64,\"></div><div class=\"brand-text\"><strong>SK SUNGAI TIRAM</strong><span>Student Information Portal</span></div></a>\n  <div class=\"top-actions\"><span class=\"online-pill\"><span class=\"live-dot\"></span> Data Google Sheet</span><button class=\"admin-btn\" id=\"adminButton\" type=\"button\"><svg class=\"icon sm\"><use href=\"#i-lock\"/></svg><span class=\"admin-label\">Log Masuk Admin</span></button></div>\n</div></header>\n<main id=\"utama\">\n<section class=\"hero\"><div class=\"container hero-grid\"><div>\n  <div class=\"eyebrow\"><svg class=\"icon sm\"><use href=\"#i-sparkle\"/></svg> SMART STUDENT DIRECTORY</div>\n  <h1>Carian Maklumat<br><span class=\"metallic\">Murid Pintar.</span></h1>\n  <p>Semak maklumat murid SK Sungai Tiram melalui satu portal yang pantas, tersusun dan mudah digunakan. Rekod diselaraskan daripada dua tab Google Sheet berdasarkan padanan nama murid.</p>\n</div><div class=\"hero-art\" aria-hidden=\"true\"><div class=\"orbit\"></div><div class=\"orbit two\"></div><div class=\"icon-sphere\"><svg class=\"icon xl\"><use href=\"#i-users\"/></svg></div><div class=\"float-tag first\"><svg class=\"icon sm\"><use href=\"#i-check\"/></svg> Padanan pintar</div><div class=\"float-tag second\"><svg class=\"icon sm\"><use href=\"#i-shield\"/></svg> Rekod dilindungi</div></div></div></section>\n<section class=\"container\"><div class=\"search-panel\">\n<div class=\"panel-heading\"><div><h2>Direktori Murid</h2><p>Masukkan nama murid untuk mula mencari. Gunakan tapisan kelas, rumah sukan dan jantina. Pilih tapisan tanpa menaip nama untuk melihat senarai berkaitan.</p></div><div class=\"panel-tag\" id=\"modeTag\"><svg class=\"icon sm\"><use href=\"#i-shield\"/></svg> Carian Guru</div></div>\n<form id=\"searchForm\" autocomplete=\"off\"><div class=\"search-row\">\n <div class=\"field\"><label for=\"q\">Nama murid <span id=\"icLabel\" class=\"hidden\">/ No. Kad Pengenalan</span></label><svg class=\"icon field-icon\"><use href=\"#i-search\"/></svg><input id=\"q\" class=\"field-input search-input\" type=\"search\" maxlength=\"100\" placeholder=\"Contoh: Nur Aisyah\" spellcheck=\"false\" autocomplete=\"off\"></div>\n <div class=\"field\"><label for=\"classFilter\">Kelas</label><select class=\"field-input\" id=\"classFilter\"><option value=\"\">Semua kelas</option></select></div>\n <div class=\"field\"><label for=\"houseFilter\">Rumah Sukan</label><select class=\"field-input\" id=\"houseFilter\"><option value=\"\">Semua rumah</option></select></div>\n <div class=\"field search-action\"><label aria-hidden=\"true\">&nbsp;</label><button type=\"submit\" class=\"search-go\" id=\"searchButton\"><svg class=\"icon sm\"><use href=\"#i-search\"/></svg> Cari Murid</button></div>\n</div>\n <div class=\"filter-extended\">\n  <div class=\"field\"><label for=\"yearFilter\">Tahun</label><select class=\"field-input\" id=\"yearFilter\"><option value=\"\">Semua tahun</option></select></div>\n  <div class=\"field\"><label for=\"genderFilter\">Jantina</label><select class=\"field-input\" id=\"genderFilter\"><option value=\"\">Semua jantina</option></select></div>\n  <div class=\"field\" id=\"healthField\"><label for=\"healthFilter\">🩺 Sejarah Perubatan</label><select class=\"field-input\" id=\"healthFilter\"><option value=\"\">Semua status</option><option value=\"ada\">🩺 Ada rekod perubatan</option><option value=\"tiada\">✅ Tiada rekod perubatan</option></select></div>\n  <div class=\"filter-explain\"><svg class=\"icon sm\"><use href=\"#i-shield\"/></svg><span>Tapisan boleh digabungkan. Rekod perubatan boleh disemak oleh guru. No. K/P hanya untuk admin.</span></div>\n </div>\n <div class=\"house-picks\" aria-label=\"Tapisan pantas rumah sukan\">\n  <span class=\"house-label\">TAPIS RUMAH SUKAN</span>\n  <div class=\"house-picks-row\">\n   <button type=\"button\" class=\"house-pick selected\" data-house=\"\" aria-pressed=\"true\">✦ Semua</button>\n   <button type=\"button\" class=\"house-pick blue\" data-house=\"BIRU\" aria-pressed=\"false\">🔵 Biru</button>\n   <button type=\"button\" class=\"house-pick green\" data-house=\"HIJAU\" aria-pressed=\"false\">🟢 Hijau</button>\n   <button type=\"button\" class=\"house-pick yellow\" data-house=\"KUNING\" aria-pressed=\"false\">🟡 Kuning</button>\n   <button type=\"button\" class=\"house-pick red\" data-house=\"MERAH\" aria-pressed=\"false\">🔴 Merah</button>\n  </div>\n </div>\n </form><div class=\"search-foot\"><div class=\"hint\"><svg class=\"icon sm\"><use href=\"#i-info\"/></svg><span id=\"searchHint\">Taip 3 aksara nama atau pilih tapisan tahun, kelas, rumah sukan, jantina atau perubatan.</span></div><button id=\"resetButton\" class=\"reset-btn\" type=\"button\"><svg class=\"icon sm\"><use href=\"#i-refresh\"/></svg> Set semula carian</button></div>\n</div></section>\n<section class=\"section\"><div class=\"container\">\n  <div class=\"section-header\"><div><div class=\"section-kicker\">HASIL CARIAN</div><h2 id=\"resultsTitle\">Temui rekod murid</h2></div><div class=\"result-actions\"><div class=\"results-count\" id=\"resultsCount\">Belum ada carian</div><button type=\"button\" id=\"printListButton\" class=\"print-list-btn\" title=\"Cetak semua murid sepadan dengan pilihan tapisan (tidak terhad kepada 40 rekod teratas)\"><svg class=\"icon sm\"><use href=\"#i-printer\"/></svg> Cetak Senarai / PDF</button></div></div>\n  <div id=\"results\"><div class=\"empty-state\"><div class=\"empty-icon\"><svg class=\"icon xl\"><use href=\"#i-search\"/></svg></div><h3>Carian murid bermula di sini</h3><p>Masukkan nama di ruangan carian. Maklumat akan dipaparkan secara automatik apabila rekod ditemui.</p></div></div>\n  <section class=\"summary\" id=\"adminSummary\" aria-label=\"Analisis data admin\"><div class=\"summary-top\"><h3>Analisis Data Admin</h3><div class=\"summary-note\">Pengesanan rekod berpadanan dan rekod yang perlu disemak</div></div><div class=\"stat-grid\" id=\"statGrid\"></div><div class=\"summary-box\"><div class=\"bars\"><h4>Pecahan Kelas</h4><div id=\"classBars\"></div></div><div class=\"bars\"><h4>Pecahan Rumah Sukan</h4><div id=\"houseBars\"></div></div></div>\n  <div class=\"secure-banner\"><svg class=\"icon lg\"><use href=\"#i-shield\"/></svg><div><strong>Privasi & keselamatan data murid</strong><p>Portal ini perlu dihadkan kepada guru sekolah melalui tetapan akses Google Workspace. Rekod perubatan ditunjukkan kepada guru untuk tujuan rasmi sahaja; nombor K/P memerlukan admin. Rekod kosong bermaksud tiada maklumat direkodkan, bukan pengesahan murid sihat. Nama berulang tidak digabungkan secara automatik.</p></div></div>\n</div></section></main>\n<footer class=\"foot\"><div class=\"container foot-in\"><span>© <span id=\"year\"></span> SK Sungai Tiram · Sistem Carian Maklumat Murid</span><span>Direka dengan teliti <span style=\"color:var(--gold)\">✦</span> · PWA Ready</span></div></footer>\n</div>\n<div class=\"toast-stack\" id=\"toastArea\" role=\"status\" aria-live=\"polite\"></div>\n<div id=\"loginModal\" class=\"modal-backdrop hidden\" role=\"dialog\" aria-modal=\"true\" aria-labelledby=\"modalTitle\">\n <div class=\"modal\"><button id=\"closeLogin\" class=\"modal-close\" title=\"Tutup\" aria-label=\"Tutup\"><svg class=\"icon sm\"><use href=\"#i-x\"/></svg></button><div class=\"modal-icon\"><svg class=\"icon lg\"><use href=\"#i-lock\"/></svg></div><h2 id=\"modalTitle\">Log Masuk Pentadbir</h2><p>Nombor kad pengenalan dan analisis pentadbir hanya boleh diakses selepas log masuk admin.</p><form id=\"loginForm\" autocomplete=\"off\"><div class=\"login-field\"><label for=\"username\">Nama pengguna</label><input id=\"username\" class=\"field-input\" type=\"text\" required autocomplete=\"username\" maxlength=\"80\" placeholder=\"Nama pengguna\"></div><div class=\"login-field\"><label for=\"password\">Kata laluan</label><div class=\"pw-wrap\"><input id=\"password\" class=\"field-input\" type=\"password\" required autocomplete=\"current-password\" placeholder=\"Kata laluan\" style=\"padding-right:45px\"><button class=\"show-pw\" id=\"showPassword\" type=\"button\" aria-label=\"Tunjuk atau sembunyikan kata laluan\"><svg class=\"icon sm\"><use href=\"#i-eye\"/></svg></button></div></div><button id=\"loginButton\" class=\"search-go login-submit\" type=\"submit\"><svg class=\"icon sm\"><use href=\"#i-lock\"/></svg> Log Masuk</button><div class=\"login-disclaimer\"><svg class=\"icon sm\"><use href=\"#i-shield\"/></svg><span>Kelayakan disahkan oleh Apps Script. Kata laluan tidak disimpan di laman ini.</span></div></form></div>\n</div>\n<div id=\"printSheet\" class=\"print-sheet\" aria-hidden=\"true\"></div>\n<script>\n'use strict';\nconst $ = id => document.getElementById(id);\nconst state = {admin:false,token:'',busy:false,bootstrap:null,results:[],searchSeq:0,debounce:null,lastTotal:0};\nconst icon = (name,cl='sm') => `<svg class=\"icon ${cl}\" aria-hidden=\"true\"><use href=\"#i-${name}\"/></svg>`;\nconst escapeHtml = v => String(v == null ? '' : v).replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\nconst displayValue = v => String(v || '').trim() ? escapeHtml(v) : '<span style=\"font-weight:500;color:#8194b1\">Tidak dinyatakan</span>';\nconst normalize = str => String(str || '').trim();\nfunction hasFilters(){return Boolean($('yearFilter').value || $('classFilter').value || $('houseFilter').value || $('genderFilter').value || $('healthFilter').value);}\nfunction searchIsReady(){const q=normalize($('q').value);const digits=q.replace(/\\D/g,'');return (!q && hasFilters()) || q.length>=3 || (state.admin && digits.length>=5 && /^\\d[\\d -]+$/.test(q));}\nfunction selectedHouseButtons(){\n const value=$('houseFilter').value.toUpperCase();\n document.querySelectorAll('.house-pick').forEach(button=>{const selected=button.dataset.house===value;button.classList.toggle('selected',selected);button.setAttribute('aria-pressed',String(selected));});\n}\nfunction badgeHouse(value){\n const raw=String(value||'').trim();if(!raw)return displayValue(raw);\n const h=raw.toUpperCase();const tones={BIRU:['blue','🔵'],HIJAU:['green','🟢'],KUNING:['yellow','🟡'],MERAH:['red','🔴']};\n const tone=tones[h];return tone?'<span class=\"house-badge '+tone[0]+'\">'+tone[1]+' '+escapeHtml(raw)+'</span>':escapeHtml(raw);\n}\nlet isReady = false;\n\nfunction server(method,args,onOK,onError){\n if(typeof google==='undefined' || !google.script || !google.script.run){\n   (onError||handleError)(new Error('Buka laman melalui URL Web App Google Apps Script atau pautan GitHub yang diterbitkan.'));\n   return;\n }\n const runner=google.script.run.withSuccessHandler(onOK).withFailureHandler(onError||handleError);\n runner[method].apply(runner,args);\n}\nfunction toast(msg,type='info'){\n const node=document.createElement('div');node.className='toast '+(type==='error'?'error':type==='ok'?'ok':'');node.textContent=msg;$('toastArea').appendChild(node);\n window.setTimeout(()=>node.remove(),4500);\n}\nfunction handleError(err){state.busy=false;setBusy(false);toast((err&&err.message)||'Ralat berlaku. Cuba lagi.','error');}\nfunction fillSelect(id,options,label){const sel=$(id);sel.innerHTML=`<option value=\"\">${escapeHtml(label)}</option>`+(options||[]).map(v=>`<option value=\"${escapeHtml(v)}\">${escapeHtml(v)}</option>`).join('');}\nfunction setBusy(busy){state.busy=busy;$('searchButton').disabled=busy;$('searchButton').innerHTML=busy?icon('refresh')+' Mencari…':icon('search')+' Cari Murid';}\nfunction setMode(admin){\n state.admin=!!admin;\n $('modeTag').innerHTML=admin?icon('check')+' Mod Pentadbir':icon('shield')+' Carian Guru';\n $('adminButton').innerHTML=admin?icon('lock')+' <span class=\"admin-label\">Log Keluar</span>':icon('lock')+' <span class=\"admin-label\">Log Masuk Admin</span>';\n $('icLabel').classList.toggle('hidden',!admin);\n\n $('q').placeholder=admin?'Nama murid atau No. KP':'Contoh: Nur Aisyah';\n $('searchHint').textContent=admin?'Carian nama: ≥3 aksara · No. K/P: ≥5 digit · Cetakan admin termasuk K/P.':'Taip 3 aksara nama atau pilih tapisan tahun, kelas, rumah sukan, jantina atau perubatan.';\n if(!admin){$('adminSummary').classList.remove('on');$('printSheet').innerHTML='';}\n selectedHouseButtons();\n}\nfunction clearResults(){state.results=[];state.lastTotal=0;$('resultsTitle').textContent='Temui rekod murid';$('resultsCount').textContent='Belum ada carian';$('results').innerHTML=`<div class=\"empty-state\"><div class=\"empty-icon\">${icon('search','xl')}</div><h3>Carian murid bermula di sini</h3><p>Masukkan nama di ruangan carian. Maklumat akan dipaparkan secara automatik apabila rekod ditemui.</p></div>`;}\nfunction requestSearch(){\n const q=normalize($('q').value);\n const numeric=q.replace(/\\D/g,'');\n const validName=q.length>=3;\n const validIC=state.admin && /^\\d[\\d -]+$/.test(q) && numeric.length>=5;\n if(!validName && !validIC && !(q.length===0 && hasFilters())){clearResults();return;}\n const seq=++state.searchSeq;setBusy(true);\n $('results').innerHTML='<div class=\"results-grid\"><div class=\"skeleton\"></div><div class=\"skeleton\"></div></div>';\n const req={query:q,year:$('yearFilter').value,className:$('classFilter').value,house:$('houseFilter').value,gender:$('genderFilter').value,health:$('healthFilter').value,token:state.token};\n server('searchStudents',[req],response=>{\n   if(seq!==state.searchSeq)return;\n   setBusy(false);\n   if(state.admin&&!response.isAdmin){sessionStorage.removeItem('skst_admin_token');state.token='';setMode(false);$('adminSummary').classList.remove('on');toast('Sesi admin telah tamat. Sila log masuk semula.','error');}\n   state.results=response.results||[];state.lastTotal=response.total||0;renderResults(response);\n },err=>{if(seq!==state.searchSeq)return;handleError(err);clearResults();});\n}\nfunction renderResults(r){\n const count=r.total||0;\n $('resultsTitle').textContent=count?'Rekod murid ditemui':'Tiada rekod ditemui';\n $('resultsCount').textContent=count?`${count} padanan${r.truncated?' · 40 teratas':''}`:'0 padanan';\n if(!count){$('results').innerHTML=`<div class=\"empty-state\"><div class=\"empty-icon\">${icon('info','xl')}</div><h3>Tiada murid sepadan</h3><p>Cuba pilihan kelas, rumah sukan, jantina atau nama yang lain.</p></div>`;return;}\n $('results').innerHTML='<div class=\"results-grid\">'+state.results.map((s,i)=>studentCard(s,i)).join('')+'</div>'+(r.truncated?'<p style=\"font-size:12px;color:#adbcd3;margin:15px 2px\">Hanya 40 rekod teratas dipaparkan. Sila perincikan carian.</p>':'');\n}\nfunction studentCard(s,i){\n const initials=(s.name||'M').split(/\\s+/).filter(Boolean).slice(0,2).map(v=>v[0]).join('').toUpperCase();\n const match=s.matchStatus==='matched';const ambiguous=s.matchStatus==='ambiguous';\n const status=match?'Disepadankan':ambiguous?'Nama berulang':'Belum dipadankan';\n const healthFlag=s.hasMedicalRecord ? '<span class=\"health-flag\" title=\"Ada rekod perubatan; butiran sulit\" aria-label=\"Ada rekod perubatan\">🩺 Ada rekod perubatan</span>' : '';\n const medicalEmoji=s.hasMedicalRecord ? '<span class=\"health-inline\" role=\"img\" aria-label=\"Rekod perubatan\">🩺</span> ' : ''; \n const caution=state.admin&& !match ?`<div class=\"data-field full\"><div class=\"medical-note\">${ambiguous?'Nama yang sama ditemui lebih daripada sekali pada salah satu tab. Padanan KP/rumah sukan disekat sehingga nama dibezakan.':'Nama ini tidak mempunyai padanan tunggal dalam tab rumah sukan.'}</div></div>`:'';\n return `<article class=\"student-card\" style=\"animation-delay:${Math.min(i*30,300)}ms\"><div class=\"student-top\"><div class=\"student-avatar\">${escapeHtml(initials)}</div><div class=\"student-title\"><h3>${escapeHtml(s.name)}</h3><small>ID rekod ${escapeHtml(s.id)}</small>${healthFlag}</div><span class=\"status-chip ${match?'':'problem'}\">${status}</span></div><div class=\"profile-grid\"><div class=\"data-field\"><span>Kelas</span><strong>${displayValue(s.className)}</strong></div><div class=\"data-field\"><span>Rumah Sukan</span><strong>${badgeHouse(s.house)}</strong></div><div class=\"data-field\"><span>Jantina</span><strong>${displayValue(s.gender)}</strong></div><div class=\"data-field\"><span>Status Data</span><strong>${match?'Lengkap':ambiguous?'Semakan diperlukan':'Tiada padanan'}</strong></div><div class=\"data-field full\"><span>Sejarah Perubatan</span><div class=\"medical-note\">${s.hasMedicalRecord?medicalEmoji+displayValue(s.medical):'✅ Tiada rekod perubatan (tidak semestinya bebas penyakit)'}</div></div>${state.admin?`<div class=\"data-field full\"><span>No. Kad Pengenalan · Admin</span><strong>${displayValue(s.identity)}</strong></div>${caution}`:''}</div><div class=\"card-footer\"><button type=\"button\" class=\"mini-btn\" data-action=\"print\" data-idx=\"${i}\">${icon('printer')} Cetak Profil</button>${state.admin?`<button type=\"button\" class=\"mini-btn\" data-action=\"csv\" data-idx=\"${i}\">${icon('download')} CSV</button>`:''}</div></article>`;\n}\nfunction showLogin(){if(state.admin){logout();return;}$('loginModal').classList.remove('hidden');$('username').focus();document.body.style.overflow='hidden';}\nfunction hideLogin(){$('loginModal').classList.add('hidden');document.body.style.overflow='';$('password').value='';}\nfunction login(event){event.preventDefault();const uname=$('username').value;const password=$('password').value;if(!uname||!password)return;\n $('loginButton').disabled=true;$('loginButton').textContent='Mengesahkan…';\n server('loginAdmin',[uname,password],res=>{\n  $('loginButton').disabled=false;$('loginButton').innerHTML=icon('lock')+' Log Masuk';\n  state.token=res.token;try{sessionStorage.setItem('skst_admin_token',res.token)}catch(e){}setMode(true);hideLogin();toast('Log masuk admin berjaya.','ok');loadAdminSummary();if(searchIsReady())requestSearch();\n },err=>{ $('loginButton').disabled=false;$('loginButton').innerHTML=icon('lock')+' Log Masuk';handleError(err); });\n}\nfunction logout(){const t=state.token;state.searchSeq++;clearTimeout(state.debounce);state.token='';$('printSheet').innerHTML='';try{sessionStorage.removeItem('skst_admin_token')}catch(e){}setMode(false);clearResults();$('q').value='';server('logoutAdmin',[t],()=>{},()=>{});toast('Anda telah log keluar.','ok');}\nfunction loadAdminSummary(){if(!state.admin)return;server('getAdminSummary',[state.token],data=>{if(!state.admin)return;\n const stats=[['Jumlah murid',data.total,'users'],['Padanan berjaya',data.matched,'check'],['Tiada padanan',data.unmatched,'search'],['Nama berulang',data.duplicate,'info']];\n $('statGrid').innerHTML=stats.map(s=>`<div class=\"stat\"><small>${escapeHtml(s[0])}</small><strong>${Number(s[1]||0).toLocaleString('ms-MY')}</strong></div>`).join('');\n $('classBars').innerHTML=barHtml(data.classes||[]);$('houseBars').innerHTML=barHtml(data.houses||[]);\n $('adminSummary').classList.add('on');\n},handleError);}\nfunction barHtml(rows){const max=Math.max(1,...rows.map(r=>r.count));return rows.length?rows.map(r=>`<div class=\"bar-item\"><span class=\"bar-name\" title=\"${escapeHtml(r.name)}\">${escapeHtml(r.name)}</span><span class=\"bar-track\"><span class=\"bar-fill\" style=\"width:${Math.max(2,(r.count/max)*100)}%;display:block\"></span></span><b>${Number(r.count)}</b></div>`).join(''):'<p style=\"color:#8a9bb5;font-size:12px\">Tiada rekod.</p>';}\nfunction csvCell(s){let text=String(s==null?'':s);if(/^[\\s]*[=+@\\-]/.test(text))text=\"'\"+text;return '\"'+text.replace(/\"/g,'\"\"')+'\"';}\nfunction downloadCsv(s){if(!state.admin)return;const header=['Nama Murid','Kelas','Jantina','Rumah Sukan','No. Kad Pengenalan','Sejarah Perubatan','Status Padanan'];const values=[s.name,s.className,s.gender,s.house,s.identity,s.medical,s.matchStatus];const csv='\\ufeff'+[header,values].map(row=>row.map(csvCell).join(',')).join('\\r\\n');const blob=new Blob([csv],{type:'text/csv;charset=utf-8'});const a=document.createElement('a');a.href=URL.createObjectURL(blob);a.download='profil-murid-'+(s.id||'rekod')+'.csv';document.body.appendChild(a);a.click();a.remove();setTimeout(()=>URL.revokeObjectURL(a.href),1000);}\nfunction currentFilters(){return {query:$('q').value.trim(),year:$('yearFilter').value,className:$('classFilter').value,house:$('houseFilter').value,gender:$('genderFilter').value,health:$('healthFilter').value,token:state.token};}\nfunction filterDescription(){const parts=[];const q=$('q').value.trim();if(q)parts.push('Carian: '+q);\n  for(const [name,key] of [['Tahun','yearFilter'],['Kelas','classFilter'],['Rumah Sukan','houseFilter'],['Jantina','genderFilter']])if($(key).value)parts.push(name+': '+$(key).value);\n  if($('healthFilter').value)parts.push('Rekod Perubatan: '+($('healthFilter').value==='ada'?'Ada rekod':'Tiada rekod'));\n  return parts.join(' • ')||'Semua murid';\n}\nfunction printCard(s){showPrint([s],'Profil Murid · '+s.name,s.hasMedicalRecord?'Ada sejarah perubatan':'Tiada rekod perubatan',state.admin);}\nfunction printAll(){\n const filters=currentFilters();\n if(!filters.query&&!hasFilters()&&!confirm('Cetak senarai SEMUA murid sekolah? Dokumen ini boleh mengandungi sejarah perubatan.'))return;\n const btn=$('printListButton');btn.disabled=true;btn.textContent='Menyediakan cetakan…';\n server('getPrintData',[filters],response=>{\n  btn.disabled=false;btn.innerHTML=icon('printer')+' Cetak Senarai / PDF';\n  if(state.admin&&!response.isAdmin){state.token='';sessionStorage.removeItem('skst_admin_token');setMode(false);toast('Sesi admin tamat. Sila log masuk semula untuk cetak nombor KP.','error');return;}\n  if(!response.results||!response.results.length){toast('Tiada murid sepadan untuk dicetak.','error');return;}\n  showPrint(response.results,'Senarai Maklumat Murid',filterDescription(),response.isAdmin);\n },err=>{btn.disabled=false;btn.innerHTML=icon('printer')+' Cetak Senarai / PDF';handleError(err);});\n}\nfunction showPrint(rows,title,description,admin){\n const printRows=(rows||[]);if(!printRows.length)return;\n const colCount=admin?7:6;\n const tableRows=printRows.map((s,i)=>`<tr><td class=\"center\">${i+1}</td><td><b>${escapeHtml(s.name)}</b></td><td>${escapeHtml(s.className)}</td><td>${escapeHtml(s.gender)}</td><td>${escapeHtml(s.house)}</td><td>${s.hasMedicalRecord?'🩺 '+escapeHtml(s.medical):'Tiada rekod'}</td>${admin?`<td>${escapeHtml(s.identity)}</td>`:''}</tr>`).join('');\n const date=new Date().toLocaleString('ms-MY',{day:'2-digit',month:'long',year:'numeric',hour:'2-digit',minute:'2-digit'});\n $('printSheet').innerHTML=`<div class=\"print-cover\"><img src=\"${$('schoolLogo').src}\" alt=\"Lencana sekolah\"><div><h1>SEKOLAH KEBANGSAAN SUNGAI TIRAM</h1><h2>${escapeHtml(title)}</h2><p>${escapeHtml(description)} · ${printRows.length} rekod · ${escapeHtml(date)}</p></div></div><div class=\"print-warning\">UNTUK KEGUNAAN DALAMAN GURU SAHAJA • Dokumen mengandungi maklumat murid dan rekod perubatan. ${admin?'Nombor kad pengenalan turut disertakan (mod admin).':''}</div><table class=\"print-table\"><thead><tr><th style=\"width:4%\">Bil</th><th style=\"width:${admin?22:25}%\">Nama Murid</th><th style=\"width:9%\">Kelas</th><th style=\"width:10%\">Jantina</th><th style=\"width:10%\">Rumah Sukan</th><th>Sejarah Perubatan</th>${admin?'<th style=\"width:14%\">No. K/P (Admin)</th>':''}</tr></thead><tbody>${tableRows}</tbody></table><div class=\"print-end\">Maklumat “Tiada rekod” tidak bermaksud murid disahkan bebas penyakit. Sumber: Google Sheet SK Sungai Tiram.</div>`;\n // Supaya imej logo siap dimuat sebelum print pada beberapa pelayar.\n const pic=$('printSheet').querySelector('img');\n if(pic&&pic.decode)pic.decode().catch(()=>{}).finally(()=>requestAnimationFrame(()=>window.print()));\n else requestAnimationFrame(()=>window.print());\n}\n\n\nfunction init(){\n $('year').textContent=new Date().getFullYear();\n // Logo lencana sudah dibenamkan pada HTML dan sentiasa kelihatan.\n $('printListButton').addEventListener('click',printAll);\n window.addEventListener('afterprint',()=>{$('printSheet').innerHTML='';});\n $('searchForm').addEventListener('submit',e=>{e.preventDefault();clearTimeout(state.debounce);requestSearch();});\n $('q').addEventListener('input',()=>{clearTimeout(state.debounce);const q=$('q').value.trim();if(!searchIsReady()){state.searchSeq++;setBusy(false);clearResults();return;}state.debounce=setTimeout(requestSearch,450);});\n const onFilterChange=()=>{selectedHouseButtons();if(searchIsReady())requestSearch();else{state.searchSeq++;clearResults();}};\n ['yearFilter','classFilter','houseFilter','genderFilter','healthFilter'].forEach(id=>$(id).addEventListener('change',onFilterChange));\n document.querySelectorAll('.house-pick').forEach(button=>button.addEventListener('click',()=>{$('houseFilter').value=button.dataset.house;onFilterChange();}));\n $('resetButton').addEventListener('click',()=>{clearTimeout(state.debounce);state.searchSeq++;setBusy(false);$('q').value='';$('yearFilter').value='';$('classFilter').value='';$('houseFilter').value='';$('genderFilter').value='';$('healthFilter').value='';selectedHouseButtons();clearResults();$('q').focus();});\n $('adminButton').addEventListener('click',showLogin);$('closeLogin').addEventListener('click',hideLogin);$('loginModal').addEventListener('click',e=>{if(e.target===$('loginModal'))hideLogin()});\n document.addEventListener('keydown',e=>{if(e.key==='Escape')hideLogin()});$('loginForm').addEventListener('submit',login);\n $('showPassword').addEventListener('click',()=>{$('password').type=$('password').type==='password'?'text':'password'});\n $('results').addEventListener('click',e=>{const button=e.target.closest('[data-action]');if(!button)return;const s=state.results[Number(button.dataset.idx)];if(!s)return;if(button.dataset.action==='csv')downloadCsv(s);if(button.dataset.action==='print')printCard(s);});\n server('getBootstrap',[],data=>{\n  state.bootstrap=data;fillSelect('yearFilter',data.years||[],'Semua tahun');fillSelect('classFilter',data.classes,'Semua kelas');fillSelect('houseFilter',data.houses,'Semua rumah');fillSelect('genderFilter',data.genders||[],'Semua jantina');selectedHouseButtons();isReady=true;\n  let token='';try{token=sessionStorage.getItem('skst_admin_token')||''}catch(e){}\n  if(token){server('resumeAdmin',[token],res=>{if(res.isAdmin){state.token=token;setMode(true);loadAdminSummary()}else{try{sessionStorage.removeItem('skst_admin_token')}catch(e){}}},()=>{});}\n },handleError);\n}\ninit();\n</script>\n</body>\n</html>\n";
